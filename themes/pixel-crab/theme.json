{
  "schemaVersion": 1,
  "name": "小螃蟹 Pixel Crab",
  "author": "beturelie & Claude",
  "version": "1.0.0",
  "description": "32×32 pixel crab with 61 expressions; chat replies can switch its mood.",
  "viewBox": {
    "x": 0,
    "y": 0,
    "width": 32,
    "height": 32
  },
  "layout": {
    "contentBox": {
      "x": 4,
      "y": 13,
      "width": 24,
      "height": 14
    },
    "centerX": 16,
    "baselineY": 27,
    "visibleHeightRatio": 0.28,
    "baselineBottomRatio": 0.05
  },
  "eyeTracking": {
    "enabled": false,
    "states": []
  },
  "states": {
    "idle": [
      "idle.svg"
    ],
    "thinking": [
      "thinking.svg"
    ],
    "working": [
      "working.svg"
    ],
    "juggling": [
      "monitors.svg"
    ],
    "error": [
      "error.svg"
    ],
    "attention": [
      "happy.svg"
    ],
    "notification": [
      "notification.svg"
    ],
    "sweeping": [
      "rewrite.svg"
    ],
    "carrying": [
      "brick.svg"
    ],
    "sleeping": [
      "sleeping.svg"
    ],
    "waking": [
      "surprised.svg"
    ]
  },
  "sleepSequence": {
    "mode": "direct"
  },
  "idleAnimations": [
    {
      "file": "humming.svg",
      "duration": 6000
    },
    {
      "file": "coffee.svg",
      "duration": 6000
    },
    {
      "file": "reading.svg",
      "duration": 6000
    },
    {
      "file": "slacking.svg",
      "duration": 6000
    }
  ],
  "hitBoxes": {
    "default": {
      "x": 4,
      "y": 13,
      "w": 24,
      "h": 14
    },
    "sleeping": {
      "x": 4,
      "y": 17,
      "w": 24,
      "h": 10
    }
  },
  "sleepingHitboxFiles": [
    "sleeping.svg"
  ],
  "reactions": {
    "drag": {
      "file": "dizzy.svg"
    },
    "clickLeft": {
      "file": "shy.svg",
      "duration": 2500
    },
    "clickRight": {
      "file": "shy.svg",
      "duration": 2500
    },
    "double": {
      "files": [
        "love.svg",
        "laugh.svg",
        "fingerheart.svg"
      ],
      "duration": 3500
    }
  },
